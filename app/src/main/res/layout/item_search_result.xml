<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/selector_card_focus"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:descendantFocusability="beforeDescendants"
        android:gravity="center_vertical">

        <!-- Contenedor de Miniatura con Duración superpuesta -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_circle_accent"
                android:src="@drawable/ic_music_note" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:background="#B3000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="3:45"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Información: Título, Artista y Tipo de Contenido -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la Canción"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Artista / Canal"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Oficial"
                android:textColor="@color/tag_official"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botones de Acción Rápida (Audio / Video) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botón Descargar Audio -->
            <ImageButton
                android:id="@+id/btnDownloadAudio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/selector_btn_circle_accent"
                android:src="@drawable/ic_download"
                android:tint="@color/accent"
                android:contentDescription="Descargar Audio"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

            <!-- Botón Descargar Video -->
            <ImageButton
                android:id="@+id/btnDownloadVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_btn_circle_magenta"
                android:src="@drawable/ic_video"
                android:tint="@color/accent_magenta"
                android:contentDescription="Descargar Video"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
