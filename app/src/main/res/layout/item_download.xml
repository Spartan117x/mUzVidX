<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/selector_card_focus"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Ícono o badge de formato -->
            <TextView
                android:id="@+id/tvFormat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_accent"
                android:gravity="center"
                android:text="MP3"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Título de la Descarga"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Artista"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Botón Reproducir -->
            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/selector_btn_circle_accent"
                android:src="@drawable/ic_play"
                android:tint="@color/accent"
                android:padding="10dp"
                android:contentDescription="Reproducir"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

        <!-- Barra de Progreso y Estado Activo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descargando… 0%"
                android:textColor="@color/status_progress"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/divider" />

            <!-- Botón Convertir a MP3 en demanda -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConvertMp3"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="8dp"
                android:text="A MP3"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_purple"
                android:textColor="@color/white"
                app:cornerRadius="16dp"
                android:visibility="gone"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:tint="@color/status_error"
                android:padding="6dp"
                android:contentDescription="Eliminar"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
