<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Contenedor Principal de Medios (Split Dinámico: Video y Visualizador de Audio) -->
    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <LinearLayout
            android:id="@+id/mediaSplitLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Contenedor de Video / Carátula -->
            <FrameLayout
                android:id="@+id/videoContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Superficie de Video ExoPlayer con TextureView (Elimina pantallas negras y z-order bugs) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:surface_type="texture_view"
                    app:resize_mode="fit" />

                <!-- Carátula de Audio HD (visible en modo Audio cuando visualizador está inactivo) -->
                <ImageView
                    android:id="@+id/ivThumb"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    android:background="@drawable/bg_circle_accent"
                    android:padding="4dp"
                    android:elevation="6dp"
                    android:visibility="visible" />

                <!-- Indicador de Carga / Buffering (Spinner Neón) -->
                <ProgressBar
                    android:id="@+id/pbLoadingTrack"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Contenedor de Barras de Audio Visuales (Graves / Medios / Agudos) -->
            <FrameLayout
                android:id="@+id/visualizerContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#E6070B14"
                android:paddingTop="60dp"
                android:paddingBottom="160dp"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <com.muzvidx.app.ui.views.AudioVisualizerView
                    android:id="@+id/visualizerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

        </LinearLayout>

        <!-- Panel de Ecualizador Completo (Reemplaza carátula en audio, overlay en video) -->
        <ScrollView
            android:id="@+id/equalizerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="160dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="#E6070B14"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header de Ecualizador y Switch ON/OFF -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ecualizador de Estudio"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEqEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activo"
                        android:textColor="@color/text_primary"
                        android:checked="true"
                        app:thumbTint="@color/accent"
                        app:trackTint="@color/accent_soft" />
                </LinearLayout>

                <!-- Selector de Presets de Ecualización -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Modos de Ecualización (Presets):"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/presetChipsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Bandas de Frecuencia Verticales / Sliders -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Bandas de Frecuencia:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/bandsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <!-- Efectos Adicionales: Bass Boost y Virtualizer 3D -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Potenciador de Graves (Bass Boost):"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekBassBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progressTint="@color/accent_magenta"
                    android:thumbTint="@color/accent_magenta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sonido Envolvente 3D (Virtualizer):"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekVirtualizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Top Bar Controls -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="#B3070B14">

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_minimize"
            android:tint="@color/text_primary"
            android:contentDescription="Minimizar" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:text="mUzVidX Player"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true" />

        <ImageButton
            android:id="@+id/btnEqualizer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_equalizer"
            android:tint="@color/accent"
            android:contentDescription="Ecualizador" />

        <!-- Botón Selector de Calidad / Resolución de Video -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuality"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="HD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:backgroundTint="#3300E5FF"
            app:cornerRadius="8dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp"
            android:visibility="gone"
            android:contentDescription="Calidad de Video" />

        <!-- Botón para Activar / Desactivar Barras de Audio Visuales -->
        <ImageButton
            android:id="@+id/btnVisualizer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_visualizer"
            android:tint="@color/text_secondary"
            android:contentDescription="Barras Visuales (Graves/Medios/Agudos)" />

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_rotate"
            android:tint="@color/text_primary"
            android:contentDescription="Girar Pantalla" />

        <ImageButton
            android:id="@+id/btnPip"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_video"
            android:tint="@color/accent"
            android:contentDescription="Ventana Flotante (PiP)" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <!-- Selector / Switch entre Modo AUDIO y Modo VIDEO -->
    <LinearLayout
        android:id="@+id/modeSwitchBar"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_below="@id/topBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search_input"
        android:orientation="horizontal"
        android:padding="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeAudio"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Audio"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:textColor="@color/bg_dark"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="15dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeVideo"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:text="Video"
            android:textSize="11sp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/text_secondary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="15dp" />
    </LinearLayout>

    <!-- Barra de Acciones y Opciones: Favoritos, Playlists, Repetición, Continuo -->
    <LinearLayout
        android:id="@+id/actionsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomControls"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp"
        android:background="#CC070B14">

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/text_primary"
            android:contentDescription="Me gusta (Favoritos)" />

        <ImageButton
            android:id="@+id/btnAddToPlaylist"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="14dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_playlist_add"
            android:tint="@color/text_primary"
            android:contentDescription="Añadir a playlist" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_secondary"
            android:contentDescription="Repetición" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchContinuous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continua"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:checked="true"
            app:thumbTint="@color/accent"
            app:trackTint="@color/accent_soft" />

    </LinearLayout>

    <!-- Bottom Controls: Título, Artista, Seekbar, Play/Prev/Next -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:background="#E6070B14">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— — —"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true" />

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="— — —"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true" />

        <!-- SeekBar & Time Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCurrentPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Botones de Reproducción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_prev"
                android:tint="@color/text_primary"
                android:contentDescription="Anterior"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@+id/btnRewind"
                android:nextFocusUp="@+id/btnFavorite" />

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_replay_10"
                android:tint="@color/text_primary"
                android:contentDescription="Retroceder 10 segundos"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@+id/btnPrev"
                android:nextFocusRight="@+id/btnPlay"
                android:nextFocusUp="@+id/btnFavorite" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle_accent"
                android:src="@drawable/ic_play"
                android:tint="@color/accent"
                android:padding="14dp"
                android:contentDescription="Reproducir o pausar"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@+id/btnRewind"
                android:nextFocusRight="@+id/btnForward"
                android:nextFocusUp="@+id/btnFavorite" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="16dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward_10"
                android:tint="@color/text_primary"
                android:contentDescription="Adelantar 10 segundos"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@+id/btnPlay"
                android:nextFocusRight="@+id/btnNext"
                android:nextFocusUp="@+id/btnRepeat" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/text_primary"
                android:contentDescription="Siguiente"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@+id/btnForward"
                android:nextFocusUp="@+id/btnRepeat" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
