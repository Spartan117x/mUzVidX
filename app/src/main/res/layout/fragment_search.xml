<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/bg_dark">

    <!-- Header de la Aplicación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_muzvidx_logo"
            android:contentDescription="mUzVidX" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mUzVidX"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Música &amp; Video Streamer"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Campo de Búsqueda Estilizado y Espacioso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:paddingVertical="4dp"
        android:background="@drawable/selector_search_input"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buscar canciones o artistas…"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:ellipsize="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/btnSearch"
            android:nextFocusDown="@+id/btnModeLibrary" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/selector_btn_circle_accent"
            android:src="@drawable/ic_search"
            android:tint="@color/bg_dark"
            android:padding="9dp"
            android:contentDescription="@string/search_btn"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@+id/etSearch"
            android:nextFocusDown="@+id/btnModeLibrary" />

    </LinearLayout>

    <!-- Selector de Modo (3 Opciones Claras: Canciones, Videos Oficiales, Modo Libre) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeLibrary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Canciones"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/bg_dark"
            app:cornerRadius="19dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/etSearch"
            android:nextFocusRight="@+id/btnModeVideos"
            android:nextFocusDown="@+id/rvResults" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeVideos"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Videos"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="19dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/etSearch"
            android:nextFocusLeft="@+id/btnModeLibrary"
            android:nextFocusRight="@+id/btnModeFree"
            android:nextFocusDown="@+id/rvResults" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeFree"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Modo Libre"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="19dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/etSearch"
            android:nextFocusLeft="@+id/btnModeVideos"
            android:nextFocusDown="@+id/rvResults" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Lista de Resultados Limpia y Ordenada -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:nextFocusUp="@+id/btnModeLibrary" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
