<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Header con Switch de Auto-Conversión a MP3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gestor de Descargas"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoConvert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto MP3"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:checked="true"
            app:thumbTint="@color/accent"
            app:trackTint="@color/accent_soft" />

    </LinearLayout>

    <!-- Subpestañas Audio / Video -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutDownloads"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_card"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/accent"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorHeight="3dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audios (M4A / MP3)" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Videos (MP4)" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Lista de Audios -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAudio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:clipToPadding="false" />

    <!-- Lista de Videos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVideo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyDownloads"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:text="No hay archivos descargados todavía"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
